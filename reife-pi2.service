[Unit]
Description=Reifeschrank Steuerung (reife-pi2)
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/reife-pi2
Environment="REIFE_ENV=prod"
ExecStart=/opt/reife-pi2/venv/bin/gunicorn \
    --workers 1 \
    --worker-class gthread \
    --threads 4 \
    --bind 0.0.0.0:5000 \
    --timeout 30 \
    --access-logfile /var/log/reife-pi2/access.log \
    --error-logfile  /var/log/reife-pi2/error.log \
    "run:app"
Restart=always
RestartSec=5

# tmpfs muss vor Start existieren
# '+' vor chown: läuft als root, unabhängig von User=pi oben —
# sonst scheitert der chown nach jedem Boot mit "Operation nicht erlaubt",
# weil das tmpfs frisch root:root gehört (siehe auch fstab uid=/gid= in setup_tmpfs.sh).
ExecStartPre=/bin/mkdir -p /run/reifeschrank
ExecStartPre=+/bin/chown pi:pi /run/reifeschrank

[Install]
WantedBy=multi-user.target
